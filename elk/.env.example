# Copier en .env puis remplir (voir les commandes de génération dans le guide).
# Ne JAMAIS committer le .env.

# Version de la suite Elastic (dernière stable au 15/10/2026)
STACK_VERSION=9.5.5
CLUSTER_NAME=ids-lab

# basic = gratuit. "trial" active 30 jours de fonctionnalités payantes (connecteurs e-mail/Slack).
LICENSE=basic

# Mots de passe : caractères alphanumériques UNIQUEMENT (le script de setup ne gère pas le reste)
ELASTIC_PASSWORD=
KIBANA_PASSWORD=

# IP de l'hôte sur le réseau NAT libvirt "default" (la victime y accède via enp1s0)
LAB_BIND_IP=192.168.122.1

# Limites mémoire des conteneurs (heap ES ≈ 50 % de ES_MEM_LIMIT)
ES_MEM_LIMIT=4g
KB_MEM_LIMIT=2g

# Clés Kibana, 32 caractères minimum (openssl rand -hex 32)
KIBANA_ENCRYPTION_KEY=
KIBANA_SAVEDOBJECTS_KEY=
KIBANA_REPORTING_KEY=
